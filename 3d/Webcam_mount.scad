// Title: Наклонная подставка для веб-камеры
// Description: Пластина с наклонным полым цилиндром по центру
// Author: AI Assistant
// Date: 2024
// License: MIT

/* =====================================================================
 *                         ПАРАМЕТРЫ
 * ===================================================================== */

// --- РАЗМЕРЫ ПЛАСТИНЫ ---
base_length = 70;       // [mm] Длина пластины
base_width = 20;        // [mm] Ширина пластины
base_thickness = 2;     // [mm] Толщина пластины

// --- РАЗМЕРЫ ЦИЛИНДРА ---
inner_diameter = 13.5;  // [mm] Внутренний диаметр
wall_thickness = 2;     // [mm] Толщина стенки
cyl_height = 9;         // [mm] Высота выступающей части цилиндра
tilt_angle = 15;        // [deg] Угол наклона от вертикали

// Автоматический расчет внешнего диаметра
outer_diameter = inner_diameter + (wall_thickness * 2); // 17.5 мм

// --- КАЧЕСТВО ---
$fn = 50;              // Гладкость окружностей

/* =====================================================================
 *                           МОДУЛИ
 * ===================================================================== */

module webcam_mount() {
    difference() {
        // 1. ОБЪЕДИНЕНИЕ (Пластина + Внешний цилиндр)
        union() {
            // Основание (центрируем по X и Y, низ на Z=0)
            translate([-base_length/2, -base_width/2, 0]) {
                cube([base_length, base_width, base_thickness]);
            }
            
            // Внешний цилиндр
            // Поднимаем на уровень верха пластины и наклоняем
            translate([0, 0, base_thickness]) {
                rotate([tilt_angle, 0, 0]) {
                    // Смещаем вниз, чтобы он "врос" в пластину для прочности
                    translate([0, 0, -base_thickness-1.2]) {
                        // Высота = выступ + толщина пластины (чтобы гарантировать слияние)
                        cylinder(h = cyl_height + base_thickness, d = outer_diameter);
                    }
                }
            }
        }

        // 2. ВЫЧИТАНИЕ (Отверстие)
        // Формируем полость внутри цилиндра
        translate([0, 0, base_thickness]) {
            rotate([tilt_angle, 0, 0]) {
                translate([0, 0, -base_thickness - 1]) { // -1 для гарантии прореза
                    cylinder(h = cyl_height + base_thickness + 5, d = inner_diameter);
                }
            }
        }
        
        // 3. ОБРЕЗКА СНИЗУ ("Строго обрезан пластинкой")
        // Отрезаем всё, что могло вылезти ниже Z=0 из-за наклона цилиндра
        translate([0, 0, -50]) {
            cube([100, 100, 100], center=true);
        }
    }
}

/* =====================================================================
 *                        ОСНОВНАЯ СБОРКА
 * ===================================================================== */

webcam_mount();

/* =====================================================================
 *                         ИНФОРМАЦИЯ
 * ===================================================================== 
 * 
 * 📏 Размеры:
 * - Пластина: 70 x 20 x 2 мм
 * - Внешний диаметр цилиндра: 17.5 мм
 * - Внутренний диаметр: 13.5 мм
 * - Высота цилиндра над пластиной: 5 мм
 * - Наклон: 20 градусов (вдоль оси Y/ширины)
 *
 * 🖨️ Рекомендации по печати:
 * - Печатать плашмя (как отображается в предпросмотре).
 * - Поддержки: Скорее всего НЕ требуются (угол 20 градусов от вертикали 
 *   или 70 от горизонтали печатается легко).
 * - Заполнение: 20-50%.
 */